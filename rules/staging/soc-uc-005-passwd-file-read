rule_id: ""

name: "SOC-UC-003-Linux-Passwd File Read Detected"

description: |
  Detects attempts to read the /etc/passwd file on Linux systems.
  Attackers access /etc/passwd to enumerate local user accounts,
  identify privileged accounts, and gather information for
  lateral movement or privilege escalation attacks.
  This technique is associated with MITRE ATT&CK T1087.001
  (Account Discovery: Local Account) and is a common step
  in post-exploitation credential harvesting workflows.

author:
  - "HRISHIKESH YALAVARTHI"

enabled: true
type: esql
language: esql

severity: "medium"
risk_score: 47

tags:
  - "Domain: Endpoint"
  - "OS: Linux"
  - "Use Case: Threat Detection"
  - "Tactic: Discovery"
  - "T1087"
  - "Data Source: Elastic Defend"

query: |
  FROM logs-endpoint.events.*
  | WHERE event.action == "open"
    AND file.path == "/etc/passwd"
    AND NOT process.name IN ("passwd", "useradd", "usermod",
                              "adduser", "nscd", "sssd",
                              "systemd", "dbus-daemon")
  | KEEP @timestamp, host.name, user.name,
         process.name, process.command_line,
         file.path, event.dataset
  | RENAME event.dataset AS logSource

interval: "5m"
from: "now-10m"
to: "now"

timestamp_override: "event.ingested"
timestamp_override_fallback_disabled: false

threat:
  - framework: "MITRE ATT&CK"
    tactic:
      id: "TA0007"
      name: "Discovery"
      reference: "https://attack.mitre.org/tactics/TA0007/"
    technique:
      - id: "T1087"
        name: "Account Discovery"
        reference: "https://attack.mitre.org/techniques/T1087/"
        subtechnique:
          - id: "T1087.001"
            name: "Local Account"
            reference: "https://attack.mitre.org/techniques/T1087/001/"

note: |
  ## Triage and Analysis

  ### What triggered this alert
  The /etc/passwd file was opened by a process on a Linux host
  indicating a possible attempt to enumerate local user accounts.

  ### Possible investigation steps
  - Identify which process opened /etc/passwd and whether it is
    a known system process or an unexpected binary
  - Check process.command_line for cat, less, more, strings or
    other read utilities that suggest manual enumeration
  - Review whether this is the first time this process accessed
    /etc/passwd or part of a repeated pattern
  - Correlate with other discovery activity from the same user
    such as whoami, id, uname or shadow file access attempts
  - Check if /etc/shadow was accessed in the same session which
    would indicate credential harvesting intent

  ### False positive analysis
  - System administration scripts that audit user accounts
    as part of compliance or configuration management tasks
  - Monitoring agents and SIEM forwarders that read system
    files to collect host inventory information

  ### Response and remediation
  - Contain: no immediate action for medium severity unless
    combined with shadow file access or privilege escalation
  - Collect: capture process tree, shell history, and all
    file access events from the same session
  - Eradicate: if malicious, terminate the session and remove
    any tools or scripts used for enumeration
  - Recover: audit all local accounts and rotate credentials
    for any accounts that may have been exposed
  - Escalate immediately if /etc/shadow was also accessed
    or if password cracking tools are found on the host

  ### References
  - https://attack.mitre.org/techniques/T1087/001/

false_positives:
  - "System administration scripts auditing user accounts for compliance"
  - "Monitoring agents collecting host inventory information"

references:
  - "https://attack.mitre.org/techniques/T1087/001/"

max_signals: 100
actions: []
