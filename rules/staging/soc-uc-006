name: "SOC-UC-004-Linux-Curl Silent Download to Temp Directory"

description: |
  Detects curl commands downloading files silently to temporary
  directories such as /tmp, /var/tmp, or /dev/shm on Linux systems.
  Attackers use curl with silent flags to download malicious payloads,
  reverse shells, or post-exploitation tools directly into writable
  directories to avoid detection and evade file integrity monitoring.
  This technique is associated with MITRE ATT&CK T1105
  (Ingress Tool Transfer) and is a common initial stage
  of multi-step compromise workflows.

author:
  - "HRISHIKESH YALAVARTHI"

enabled: true
type: esql
language: esql

severity: "high"
risk_score: 73

tags:
  - "Domain: Endpoint"
  - "OS: Linux"
  - "Use Case: Threat Detection"
  - "Tactic: Command and Control"
  - "T1105"
  - "Data Source: Elastic Defend"

query: |
  FROM logs-endpoint.events.*
  | WHERE event.action == "exec"
    AND process.name == "curl"
    AND (
      process.command_line LIKE "*-o /tmp/*"
      OR process.command_line LIKE "*-o /var/tmp/*"
      OR process.command_line LIKE "*-o /dev/shm/*"
      OR process.command_line LIKE "*--output /tmp/*"
      OR process.command_line LIKE "*--output /var/tmp/*"
      OR process.command_line LIKE "*--output /dev/shm/*"
    )
  | KEEP @timestamp, host.name, user.name,
         process.name, process.command_line,
         process.parent.name, process.parent.command_line,
         event.dataset
  | RENAME event.dataset AS logSource

interval: "5m"
from: "now-10m"
to: "now"

timestamp_override: "event.ingested"
