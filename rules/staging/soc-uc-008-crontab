  - "Data Source: Elastic Defend"

query: |
  FROM logs-endpoint.events.*
  | WHERE event.action == "exec"
    AND process.name == "crontab"
    AND process.args LIKE "*-e*"
    AND NOT user.name IN ("root", "cron", "daemon")
  | KEEP @timestamp, host.name, user.name,
         process.name, process.args,
         process.command_line,
         process.parent.name,
         event.dataset
  | RENAME event.dataset AS logSource

